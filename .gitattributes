# Track large CSVs via Git LFS so the repo stays light.
# Activate by running `git lfs install` once on your machine.
data/processed/*.csv filter=lfs diff=lfs merge=lfs -text
data/interim/*.csv   filter=lfs diff=lfs merge=lfs -text
data/validation/*.csv filter=lfs diff=lfs merge=lfs -text
*.xlsx filter=lfs diff=lfs merge=lfs -text
*.xls  filter=lfs diff=lfs merge=lfs -text
