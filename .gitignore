htmlcov/
coverage.xml

# Raw bibliographic exports — bundled in this repo for reproducibility.
# Users should review Scopus/WoS/IEEE license terms before redistributing.

# Intermediate outputs are regenerable; gitignored by default
data/interim/*.csv
!data/**/.gitkeep
!data/**/README.md

# Output artifacts (regenerable)
outputs/figures/*.pdf
outputs/figures/*.png
outputs/figures/*.svg
outputs/tables/*.tex
outputs/reports/*.html
outputs/reports/*.md

# Logs
*.log
logs/

# Local environment
.env
.env.local
